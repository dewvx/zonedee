# คัดลอกไฟล์นี้เป็น .env (อยู่โฟลเดอร์เดียวกัน) แล้วใส่ค่า — .env ไม่ขึ้น git
# วิธีเอาค่า: ดู "แจ้งเตือน LINE" ใน README.md

# LINE Developers → channel ของ Official Account → แท็บ Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers → channel เดียวกัน → แท็บ Basic settings → Your user ID (ขึ้นต้นด้วย U)
LINE_USER_ID=

# (ไม่บังคับ) Google Gemini API Key สำหรับให้ AI สรุปข่าวหุ้นภาษาไทยเชิงลึก (ดึงฟรีจาก Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# (ไม่บังคับ) Anthropic Claude API Key สำหรับให้ Claude (Haiku/Sonnet) สรุปข่าวหุ้น (ดึงจาก Anthropic Console: https://console.anthropic.com/)
ANTHROPIC_API_KEY=
