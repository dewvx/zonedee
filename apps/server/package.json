{
  "name": "@zonedee/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/index.ts",
    "fetch": "tsx --no-warnings=ExperimentalWarning src/fetch-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "backtest": "tsx --no-warnings=ExperimentalWarning src/backtest-cli.ts"
  },
  "dependencies": {
    "@zonedee/core": "*",
    "dukascopy-node": "^1.50.0",
    "express": "^5.3.0",
    "yahoo-finance2": "^4.0.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
